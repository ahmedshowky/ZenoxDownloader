<Window x:Class="ZenoxDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZenoxDownloader"
        xmlns:vm="clr-namespace:ZenoxDownloader.ViewModels"
        xmlns:models="clr-namespace:ZenoxDownloader.Models"
        mc:Ignorable="d"
        Title="Zenox Downloader" Height="700" Width="1000"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Status Color Converter (Simple Style Trigger approach used in Template instead) -->
        
        <DataTemplate x:Key="VideoItemTemplate" DataType="{x:Type models:VideoItem}">
            <Border Background="White" CornerRadius="8" Margin="0,0,0,10" Padding="10" 
                    BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/> <!-- Thumbnail -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/> <!-- Controls -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- Thumbnail -->
                    <Border CornerRadius="5" Background="#EEE" ClipToBounds="True">
                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                    </Border>
                    
                    <!-- Info -->
                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="3" Padding="5,2" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Duration}" FontSize="11" Foreground="#5D4037"/>
                            </Border>
                            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                        
                        <!-- Progress -->
                        <Grid Margin="0,10,0,0">
                            <ProgressBar Value="{Binding Progress}" Height="6" BorderThickness="0" Background="#ECF0F1" Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Status Badge / Controls -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryBrush}"/>
                        <!-- Placeholder for buttons: Pause/Cancel -->
                        <Button Content="✕" Width="25" Height="25" Padding="0" Background="Transparent" 
                                Foreground="Gray" Margin="0,5,0,0" HorizontalAlignment="Right"
                                Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Input -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20">
            <TextBlock Text="Zenox Downloader" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- Input Section -->
        <Border Grid.Row="1" Background="White" Padding="20" BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- URL Row -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8" VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource SecondaryBrush}"/>
                    <TextBlock IsHitTestVisible="False" Text="Paste Video or Playlist URL here..." Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Url}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <Button Grid.Column="1" Content="Analyze &amp; Download" Command="{Binding ProcessUrlCommand}" 
                            FontSize="14" FontWeight="Bold" Margin="10,0,0,0" Padding="15,0" Height="40"/>
                </Grid>

                <!-- Settings Expander / Area -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Directory -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,20,0">
                        <Button Content="📂" Command="{Binding BrowseCommand}" Background="{StaticResource SecondaryBrush}" Width="30" Height="30" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding OutputDirectory}" VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="150" ToolTip="{Binding OutputDirectory}"/>
                    </StackPanel>

                    <!-- Quality -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="0,0,20,0">
                        <TextBlock Text="Quality:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                        <ComboBox SelectedItem="{Binding SelectedQuality}" Width="120" Padding="5">
                            <ComboBoxItem Content="Best Available"/>
                            <ComboBoxItem Content="1080p"/>
                            <ComboBoxItem Content="720p"/>
                            <ComboBoxItem Content="Audio Only (MP3)"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Subtitles Toggles -->
                    <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
                        <StackPanel.Resources>
                            <Style TargetType="CheckBox">
                                <Setter Property="Margin" Value="0,0,15,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </StackPanel.Resources>
                        <CheckBox IsChecked="{Binding AutoSubs}" Content="Auto Subs"/>
                        <CheckBox IsChecked="{Binding EmbedSubs}" Content="Embed"/>
                        <RadioButton IsChecked="{Binding IsVtt}" Content=".vtt" GroupName="Fmt" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <RadioButton IsChecked="{Binding IsSrt}" Content=".srt" GroupName="Fmt" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="2" Padding="20">
            <Grid>
                <!-- Waiting State -->
                <TextBlock Text="Enter a URL to start." Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VideoList.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Loading State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Processing..." FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="5" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Playlist / Queue List -->
                <ListBox ItemsSource="{Binding VideoList}" 
                         ItemTemplate="{StaticResource VideoItemTemplate}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0" Background="Transparent"
                         Padding="0,0,10,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Trim Video" Command="{Binding TrimVideoCommand}"/>
                                        <MenuItem Header="Open" Command="{Binding OpenFileCommand}"/>
                                        <MenuItem Header="Open File Location" Command="{Binding OpenFolderCommand}"/>
                                        <MenuItem Header="Copy URL" Command="{Binding CopyUrlCommand}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" Padding="10" BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
            </StackPanel>
        </Border>
        
    </Grid>
</Window>

